PORT=4127
JWT_SECRET=replace-with-a-long-random-secret

# Store only SHA-256 hashes here. Generate with:
# npm run hash-code -- "your-secret-code"
OFFICIAL_CODE_HASH=
OWNER_CODE_HASH=

# Optional integration hook for the broader Kaiju/Caspian app.
KAIJU_PLATFORM_API_KEY=

# Server-side only. Never expose this in client-side code.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
